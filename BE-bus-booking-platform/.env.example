# Server
PORT=8080

# Database
# Docker: postgres://postgres:postgres@db:5432/bus_booking?sslmode=disable
# Local:  postgres://postgres:postgres@localhost:5432/bus_booking?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bus_booking?sslmode=disable

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h

# Rate limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=1m

# SMTP (optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@busbooking.com

# AWS S3 (optional)
AWS_BUCKET=
AWS_REGION=us-east-1

# App URL
APP_URL=http://localhost:5173

# FlexPay
FLEXPAY_BASE_URL=https://backend.flexpay.cd
FLEXPAY_AUTHORIZATION=your_jwt_token_here
FLEXPAY_MERCHANT=KIVUGC