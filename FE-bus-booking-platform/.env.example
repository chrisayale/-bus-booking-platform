# Frontend Environment Variables
# Copy this file to .env.local for local development overrides

# API Base URL for production (Netlify)
# In development (npm run dev), leave empty or unset to use Vite proxy at /api -> http://localhost:8080
# In production (Netlify), set to your Render backend URL:
# VITE_API_URL=https://ayaletrans.onrender.com

# Example for local development with a different backend:
# VITE_API_URL=http://localhost:8080